{
  "name": "speed-measure-opencode-plugin",
  "version": "0.1.1",
  "description": "OpenCode TUI plugin to display LLM prefill and decode speeds in the sidebar",
  "type": "module",
  "exports": {
    "./tui": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/transform-solid.mjs",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/japan4415/speed-measure-opencode-plugin.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "opentui",
    "speed-measure"
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/japan4415/speed-measure-opencode-plugin/issues"
  },
  "homepage": "https://github.com/japan4415/speed-measure-opencode-plugin#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.15.0",
    "solid-js": "1.9.12"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@opencode-ai/plugin": "1.18.30",
    "@opencode-ai/sdk": "1.18.30",
    "@opentui/solid": "^0.5.11",
    "babel-preset-solid": "1.9.12",
    "solid-js": "1.9.12",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
